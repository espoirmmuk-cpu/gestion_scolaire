use std::net::TcpStream;
use std::process::{Command, Stdio};
use std::thread;
use std::time::Duration;
use tauri::Manager;

#[cfg(target_os = "windows")]
use std::os::windows::process::CommandExt;

#[cfg_attr(mobile, tauri::mobile_entry_point)]
pub fn run() {
    tauri::Builder::default()
        .setup(|app| {
            if cfg!(debug_assertions) {
                app.handle().plugin(
                    tauri_plugin_log::Builder::default()
                        .level(log::LevelFilter::Info)
                        .build(),
                )?;
            }

            #[cfg(not(debug_assertions))]
            {
                let resource_dir = app
                    .path()
                    .resource_dir()
                    .expect("Impossible de trouver le dossier des ressources");

                let php_path = resource_dir
                    .join("runtime")
                    .join("php")
                    .join("php.exe");

                let laravel_path = resource_dir.join("app");

                let artisan_path = laravel_path.join("artisan");

                let log_path = resource_dir.join("laravel-start.log");

                let log_file = std::fs::OpenOptions::new()
                    .create(true)
                    .append(true)
                    .open(&log_path)
                    .expect("Impossible d'ouvrir le fichier de log");

                let log_file_err = log_file
                    .try_clone()
                    .expect("Impossible de dupliquer le fichier de log");

                match Command::new(&php_path)
                    .creation_flags(0x08000000)
                    .arg("artisan")
                    .args([
                        "serve",
                        "--host=127.0.0.1",
                        "--port=8000",
                    ])
                    .current_dir(&laravel_path)
                    .stdout(Stdio::from(log_file))
                    .stderr(Stdio::from(log_file_err))
                    .spawn()
                {
                    Ok(_) => {
                        let _ = std::fs::OpenOptions::new()
                            .create(true)
                            .append(true)
                            .open(&log_path)
                            .and_then(|mut file| {
                                use std::io::Write;

                                writeln!(
                                    file,
                                    "PHP lancé avec succès.\nPHP: {:?}\nLaravel: {:?}\n",
                                    php_path, artisan_path
                                )
                            });
                    }

                    Err(e) => {
                        let _ = std::fs::write(
                            &log_path,
                            format!(
                                "ERREUR lancement PHP:\n{}\nPHP: {:?}\nLaravel: {:?}\n",
                                e, php_path, artisan_path
                            ),
                        );

                        return Err(e.into());
                    }
                }

                for _ in 0..50 {
                    if TcpStream::connect("127.0.0.1:8000").is_ok() {
                        break;
                    }

                    thread::sleep(Duration::from_millis(200));
                }
            }

            Ok(())
        })
        .run(tauri::generate_context!())
        .expect("error while running tauri application");
}