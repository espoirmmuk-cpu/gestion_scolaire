{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "GESCO",
    "version":  "0.1.0",
    "identifier":  "cd.gesco.desktop",
    "build":  {
                  "beforeDevCommand":  "runtime\\start-gesco.bat",
                  "frontendDist":  "http://127.0.0.1:8000",
                  "devUrl":  "http://127.0.0.1:8000"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "GESCO - Gestion Scolaire",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  1000,
                                    "minHeight":  650,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "resources":  {
                                     "../runtime":  "runtime",
                                     "../build/laravel":  "app"
                                 }
               }
}